{
  "name": "mirofish",
  "version": "0.1.0",
  "description": "MiroFish - 简洁通用的群体智能引擎，预测万物",
  "scripts": {
    "dev": "concurrently --kill-others -n \"AGENT,TUNNEL\" -c \"green,magenta\" \"npm run agent\" \"npm run tunnel\"",
    "agent": "./.venv-backend/bin/python run_mirofish.py --live --interval 60",
    "tunnel": "npx localtunnel --port 8080 --subdomain shibin-mirofish-journal"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "AGPL-3.0"
}
